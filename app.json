{
  "expo": {
    "name": "Vytal",
    "slug": "nutrovia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vytal",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "es.getvytal.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B1A17",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "es.getvytal.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1A17",
          "image": "./assets/images/vytal-mark-white.png",
          "imageWidth": 90
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Vytal usa la cámara para fotografiar tus comidas y analizarlas."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e688b4c-b2af-4389-b432-3acab0c616bc"
      }
    },
    "owner": "edward15001s-team"
  }
}
